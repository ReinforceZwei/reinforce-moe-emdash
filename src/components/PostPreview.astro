---
import { Image } from "emdash/ui";

interface Props {
	post: any;
	category?: { slug: string; label: string } | null;
	tags?: { slug: string; label: string }[];
}

const { post, category = null, tags = [] }: Props = Astro.props;

const date = post.data.publishedAt ?? post.data.createdAt;
const published = date
	? new Date(date).toLocaleDateString("zh-TW", {
			year: "numeric",
			month: "short",
			day: "numeric",
			weekday: "short",
			timeZone: "Asia/Hong_Kong",
		})
	: "";
const excerpt = post.data.excerpt
	? String(post.data.excerpt).slice(0, 100) + "..."
	: "";
const fi = post.data.featured_image;
const firstInline = (post.data.content ?? []).find((b: any) => b?._type === "image");

const MEDIA_ROUTE = "/_emdash/api/media/file/";

/**
 * Blocks from the seed carry `asset.url` as the internal media route, and Astro
 * cannot transform a same-origin runtime URL - it emits a srcset of identical
 * URLs instead. Resolve the storage key and ask the storage adapter for the
 * CDN URL so the image goes through /_image like the post body does.
 */
function toPublicMediaUrl(url?: string | null, storageKey?: string | null): string | null {
	if (!url) return null;
	let key = storageKey ?? null;
	if (!key && url.startsWith(MEDIA_ROUTE)) key = decodeURIComponent(url.slice(MEDIA_ROUTE.length));
	if (!key) return url;
	return Astro.locals.emdash?.getPublicMediaUrl?.(key) ?? url;
}

/**
 * List queries do not expand featured media, so the field often carries only a
 * URL. Dimensions matter: emdash's <Image> only emits a /_image srcset when
 * width and height resolve, otherwise it silently degrades to a plain <img>.
 * Fall back to the first inline block, which carries them after the
 * backfill-image-dimensions script has run.
 */
const featuredImage =
	fi?.src || fi?.url
		? {
				src: toPublicMediaUrl(fi.src ?? fi.url, fi.meta?.storageKey),
				alt: fi.alt,
				width: fi.width,
				height: fi.height,
			}
		: firstInline?.asset?.url
			? {
					src: toPublicMediaUrl(firstInline.asset.url, firstInline.asset.meta?.storageKey),
					alt: firstInline.alt,
					width: firstInline.width,
					height: firstInline.height,
				}
			: null;
const featuredAlt = featuredImage?.alt ?? post.data.title;
---

<div>
  <h1>
    <a href={`/posts/${post.id}`}>{post.data.title}</a>
  </h1>
  {featuredImage && (
    <a href={`/posts/${post.id}`} class="post-preview-image">
      <Image image={featuredImage} alt={featuredAlt} />
    </a>
  )}
  {excerpt && <p>{excerpt}</p>}
  <div>
    <a href={`/posts/${post.id}`} class="read-more">閲讀全文</a>
  </div>
  <div class="info-section">
    <div>{published}</div>
    {category && (
      <div class="category">
        分類：<a href={`/category/${category.slug}`}>{category.label}</a>
      </div>
    )}
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag, index) => (
          <>
            <a href={`/tag/${tag.slug}`} class="tag">{tag.label}</a>
            {index < tags.length - 1 && <span class="tag-separator">, </span>}
          </>
        ))}
      </div>
    )}
  </div>
  <hr />
</div>

<style>
.info-section {
  margin-top: 2rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
}
.category {
  margin-top: 0.5rem;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 0.5rem;
  align-items: baseline;
}
.tag {
  font-size: 0.8em;
  color: inherit;
}
.tag-separator {
  margin-right: 0.3rem;
}
hr {
  border: none !important;
  text-align: center;
}
hr::before {
  color: currentColor;
  content: "···";
  font-family: serif;
  font-size: 1.5em;
  letter-spacing: 2em;
  padding-left: 2em;
}
/* The <figure>/<img> now come from emdash's <Image>, so target them with :global(). */
.post-preview-image {
  display: block;
  margin-top: 4rem;
  margin-bottom: 3rem;
}
.post-preview-image :global(img) {
  width: 100%;
  height: auto;
}
</style>
