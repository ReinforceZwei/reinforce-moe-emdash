---
import { Image } from "emdash/ui";
import { EMPTY_TERMS, type NormalizedTerms } from "../lib/content/terms";
import { resolvePostImage } from "../lib/content/media";
import type { PostEntry } from "../lib/content/types";
import { formatPostDate, postDate } from "../lib/format";

interface Props {
  post: PostEntry;
  terms?: NormalizedTerms;
}

const { post, terms = EMPTY_TERMS }: Props = Astro.props;

const published = formatPostDate(postDate(post));
const excerpt = post.data.excerpt ? `${String(post.data.excerpt).slice(0, 100)}...` : "";
const image = resolvePostImage(post, Astro.locals.emdash?.getPublicMediaUrl);
const { category, tags } = terms;
---

<article class="post-preview">
  <h2>
    <a href={`/posts/${post.id}`}>{post.data.title}</a>
  </h2>
  {image && (
    <a href={`/posts/${post.id}`} class="post-preview-image">
      <Image image={image} alt={image.alt ?? post.data.title} />
    </a>
  )}
  {excerpt && <p>{excerpt}</p>}
  <div>
    <a href={`/posts/${post.id}`} class="read-more">閲讀全文</a>
  </div>
  <div class="info-section">
    <div>{published}</div>
    {category && (
      <div class="category">
        分類：<a href={`/category/${category.slug}`}>{category.label}</a>
      </div>
    )}
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag, index) => (
          <>
            <a href={`/tag/${tag.slug}`} class="tag">{tag.label}</a>
            {index < tags.length - 1 && <span class="tag-separator">, </span>}
          </>
        ))}
      </div>
    )}
  </div>
  <hr />
</article>

<style>
/* Cards sit under the page-level <h1>, so their title is an <h2>; the size
   stays at the display step so the list looks unchanged. */
.post-preview h2 {
  font-size: var(--font-size-h1);
}
.info-section {
  margin-top: var(--space-6);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
}
.category {
  margin-top: var(--space-2);
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-2);
  align-items: baseline;
}
.tag {
  font-size: 0.8em;
  color: inherit;
}
.tag-separator {
  margin-right: 0.3rem;
}
hr {
  border: none;
  text-align: center;
}
hr::before {
  color: currentColor;
  content: "···";
  font-family: serif;
  font-size: 1.5em;
  letter-spacing: 2em;
  padding-left: 2em;
}
/* The <figure>/<img> now come from emdash's <Image>, so target them with :global(). */
.post-preview-image {
  display: block;
  margin-top: var(--space-8);
  margin-bottom: var(--space-7);
}
.post-preview-image :global(img) {
  width: 100%;
  height: auto;
}
</style>
