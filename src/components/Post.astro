---
import { PortableText } from "emdash/ui";
import Container from "./Container.astro";

interface Props {
	post: any;
	terms?: { taxonomy?: string; name?: string; slug: string; label: string }[];
}
const { post, terms = [] }: Props = Astro.props;

const date = post.data.publishedAt ?? post.data.createdAt;
const publishedDate = date
	? new Date(date).toLocaleDateString("zh-TW", {
			year: "numeric",
			month: "short",
			day: "numeric",
			weekday: "short",
			timeZone: "Asia/Hong_Kong",
		})
	: "";
const category = terms.find((t) => (t.taxonomy ?? t.name) === "category");
const tags = terms.filter((t) => (t.taxonomy ?? t.name) === "tag");
---

<Container>
  <h1 {...post.edit.title}>{post.data.title}</h1>
  <div class="post-meta">
    <div class="date">{publishedDate}</div>
    {category && (
      <div class="category">
        分類：<a href={`/category/${category.slug}`}>{category.label}</a>
      </div>
    )}
    {tags.length > 0 && (
      <div class="tags">
        標籤：{tags.map((tag, index) => (
          <>
            <a href={`/tag/${tag.slug}`} class="tag">{tag.label}</a>
            {index < tags.length - 1 && <span class="tag-separator">, </span>}
          </>
        ))}
      </div>
    )}
  </div>
  <hr />
  <div class="spacer"></div>
  <div class="post-content">
    <PortableText value={post.data.content} />
  </div>
  <div class="spacer"></div>
</Container>

<style>
h1 {
  margin-bottom: 1rem;
}
.post-meta {
  margin-top: 2rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}
.post-content {
  max-width: 600px;
  margin-inline: auto;
}
.category {
  font-size: 0.9rem;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  font-size: 0.9rem;
}
.tag {
  color: inherit;
}
.tag-separator {
  margin-right: 0.3rem;
}
.spacer {
  height: 32px;
  margin-block-start: 32px;
}
</style>
