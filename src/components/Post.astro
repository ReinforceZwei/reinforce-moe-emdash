---
import Prose from "./prose/Prose.astro";
import { Comments, CommentForm } from "emdash/ui/comments";
import Container from "./Container.astro";
import { EMPTY_TERMS, type NormalizedTerms } from "../lib/content/terms";
import type { PostEntry } from "../lib/content/types";
import { formatPostDate, postDate } from "../lib/format";
import "../styles/prose.css";
import "../styles/comments.css";

interface Props {
  post: PostEntry;
  terms?: NormalizedTerms;
}
const { post, terms = EMPTY_TERMS }: Props = Astro.props;

const publishedDate = formatPostDate(postDate(post));
const { category, tags } = terms;

// EmDash's built-in comments (emdash/ui/comments) ship English defaults.
const commentLabels = {
  heading: (count: number) => (count === 0 ? "暫無留言" : `${count} 則留言`),
  member: "站內會員",
  like: "喜歡",
};

const commentFormLabels = {
  name: "名稱",
  email: "電子郵件",
  comment: "留言內容",
  submit: "送出留言",
  submitting: "送出中…",
  published: "留言已發佈",
  pending: "留言已送出，待審核後顯示",
  error: "送出失敗，請稍後再試",
  networkError: "網絡錯誤，請再試一次",
};

// Optional Cloudflare Turnstile. Both values are optional: with no site key the
// widget is skipped, and the server only verifies when EMDASH_TURNSTILE_SECRET_KEY
// is set. See README → Comments.
//
// Read `process.env`, not `import.meta.env.PUBLIC_TURNSTILE_SITE_KEY`: Vite
// statically replaces `import.meta.env.*` during the build, which would bake the
// key (or `undefined`) into the image and make the runtime env in compose/dev
// useless. This page is server-rendered, so the frontmatter runs per request.
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Container>
  <article class="post">
    <h1 {...post.edit?.title}>{post.data.title}</h1>
    <div class="post-meta">
      <div class="date">{publishedDate}</div>
      {category && (
        <div class="category">
          分類：<a href={`/category/${category.slug}`}>{category.label}</a>
        </div>
      )}
      {tags.length > 0 && (
        <div class="tags">
          標籤：{tags.map((tag, index) => (
            <>
              <a href={`/tag/${tag.slug}`} class="tag">{tag.label}</a>
              {index < tags.length - 1 && <span class="tag-separator">, </span>}
            </>
          ))}
        </div>
      )}
    </div>
    <hr />
    <div class="post-content">
      <Prose value={post.data.content} />
    </div>
  </article>

  <div class="post-comments">
    <Comments
      collection="posts"
      contentId={post.data.id}
      threaded
      reactions
      labels={commentLabels}
    />
    <CommentForm
      collection="posts"
      contentId={post.data.id}
      labels={commentFormLabels}
      turnstileSiteKey={turnstileSiteKey}
    />
  </div>
</Container>

<style>
h1 {
  margin-bottom: var(--space-4);
}
.post-meta {
  margin-top: var(--space-6);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
}
.post-content {
  max-width: var(--measure-prose);
  /* Replaces the two empty .spacer divs that used to flank the prose. */
  margin-block: var(--space-8);
  margin-inline: auto;
}
.category {
  font-size: 0.9rem;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  font-size: 0.9rem;
}
.tag {
  color: inherit;
}
.tag-separator {
  margin-right: 0.3rem;
}
</style>
