---
import { WidgetArea } from "emdash/ui";
import { getWidgetAreaWithCacheHint } from "emdash";

// `WidgetArea` renders nothing when the area is missing or empty, so the area is
// read here to decide whether the divider belongs on the page at all. This also
// registers the cache hint, so an editor's save is visible on cached routes.
const { data: area, cacheHint } = await getWidgetAreaWithCacheHint("home-spotlight");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const hasWidgets = Boolean(area?.widgets?.length);
---

<div class="spotlight">
  <img src="/hertaa1.gif" alt="くるくる" width="250" height="250" />
  {hasWidgets && (
    <>
      <hr />
      <WidgetArea name="home-spotlight" />
    </>
  )}
</div>

<style>
.spotlight {
  text-align: center;
}
.spotlight img {
  display: inline-block;
}
</style>
