---
interface Props {
  /** Site title from EmDash settings. */
  siteTitle: string;
  tagline?: string;
}

const { siteTitle, tagline = "" } = Astro.props;
---

<footer class="footer">
  <div class="inner">
    <div class="footer-meta">
      <a href="/">{siteTitle}</a>
      {tagline && <span>{tagline}</span>}
    </div>
    <div>
      <a class="admin-link" href="/_emdash/admin">登入</a>
    </div>
  </div>
</footer>

<style>
.footer {
  padding-top: var(--space-10);
  padding-left: var(--space-3);
  padding-right: var(--space-3);
}
.inner {
  max-width: var(--measure-wide);
  display: flex;
  justify-content: space-between;
  margin-left: auto;
  margin-right: auto;
  padding-top: var(--space-8);
  padding-bottom: var(--space-8);
}
.footer-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.admin-link {
  color: inherit;
}
.admin-link:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}
</style>
