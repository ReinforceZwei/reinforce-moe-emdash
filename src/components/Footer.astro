---
interface Props {
  /** Site title from EmDash settings. */
  siteTitle: string;
  tagline?: string;
}

const { siteTitle, tagline = "" } = Astro.props;
---

<footer class="footer">
  <div class="inner">
    <div>
      <a href="/">{siteTitle}</a>
    </div>
    {tagline && <div>{tagline}</div>}
  </div>
</footer>

<style>
.footer {
  padding-top: var(--space-10);
  padding-left: var(--space-3);
  padding-right: var(--space-3);
}
.inner {
  max-width: var(--measure-wide);
  display: flex;
  justify-content: space-between;
  margin-left: auto;
  margin-right: auto;
  padding-top: var(--space-8);
  padding-bottom: var(--space-8);
}
</style>
