---
import Prose from "./prose/Prose.astro";
import Container from "./Container.astro";
import type { PageEntry } from "../lib/content/types";
import "../styles/prose.css";

interface Props {
	page: PageEntry;
}
const { page }: Props = Astro.props;
---

<Container>
  <article class="page">
    <h1 {...page.edit?.title}>{page.data.title}</h1>
    <hr />
    <div class="post-content">
      <Prose value={page.data.content} />
    </div>
  </article>
</Container>

<style>
h1 {
  margin-bottom: var(--space-4);
}
.post-content {
  max-width: var(--measure-prose);
  /* Replaces the empty .spacer div that used to sit above the prose. */
  margin-block-start: var(--space-8);
  margin-inline: auto;
}
</style>
