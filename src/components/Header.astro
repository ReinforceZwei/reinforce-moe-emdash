---
import type { Menu } from "emdash";

interface Props {
  /** On the home page the site title is the page's only <h1>; elsewhere it is a span. */
  isHome?: boolean;
  /** Primary menu from EmDash; the editor owns the navigation. */
  menu?: Menu | null;
}

const { isHome = false, menu = null } = Astro.props;
const SiteTitle = isHome ? "h1" : "span";
const items = menu?.items ?? [];
---

<header class="header">
  <div class="container">
    <SiteTitle class="site-title">
      <a href="/">REINFORCE.MOE</a>
    </SiteTitle>

    {items.length > 0 ? (
      <nav class="site-nav" aria-label="主選單">
        <ul>
          {items.map((item) => (
            <li>
              <a href={item.url} target={item.target} title={item.titleAttr}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <div>
        <a href="/about">關於 Reinforce II</a>
      </div>
    )}
  </div>
</header>

<style>
.header {
  background: linear-gradient(135deg, var(--color-brand-from) 0%, var(--color-brand-to) 100%);
  padding: var(--space-2);
  position: relative;
}
.container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-left: auto;
  margin-right: auto;
  max-width: var(--measure-wide);
  padding-bottom: var(--space-4);
  padding-top: var(--space-9);
}
.site-title {
  font-size: var(--font-size-h5);
  margin: 0;
}
.site-nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}
.site-nav li {
  margin: 0;
}
</style>
