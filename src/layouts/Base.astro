---
/**
 * Document shell.
 *
 * SEO lives in two places by design: `resolveSeo()` (src/lib/seo.ts) decides
 * the values, and `EmDashHead` renders them. This layout only forwards the
 * resolved context — it no longer composes titles, picks separators, or emits
 * its own icon tag, so there is no second copy of the precedence rules.
 *
 * `SiteHead` adds the tags EmDash cannot emit (og:locale, theme-color, sized
 * icons).
 */
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import type { Menu } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/noto-sans-tc";
import "@fontsource-variable/noto-sans-mono";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/base.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteHead from "../components/SiteHead.astro";
import { SITE_LOCALE, type SeoContext } from "../lib/seo";

interface Props {
	seo: SeoContext;
}

const { seo } = Astro.props;

const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const settings = settingsResult.data as {
	title?: string;
	tagline?: string;
	favicon?: { url?: string } | null;
};
const siteTagline = settings.tagline ?? "";
const menu = menuResult.data as Menu | null;

const pageCtx = createPublicPageContext({
	Astro,
	kind: seo.content ? "content" : "custom",
	pageType: seo.pageType,
	title: seo.title,
	pageTitle: seo.pageTitle,
	description: seo.description,
	canonical: seo.canonical,
	image: seo.image,
	articleMeta: seo.article,
	content: seo.content,
	siteName: seo.siteName,
	siteUrl: seo.siteUrl,
	// EmDashHead reads robots from the page context's `seo` block; without this
	// a `noindex` decision would be dropped before it reaches the head.
	seo: seo.robots ? { robots: seo.robots } : undefined,
});
---

<!doctype html>
<html lang={SITE_LOCALE}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{seo.title}</title>
		<EmDashHead page={pageCtx} />
		<SiteHead seo={seo} faviconUrl={settings.favicon?.url ?? null} />
		{
			/*
			 * Google Analytics 4 (G-LZ7NMQ1R85). Kept in the layout rather than a
			 * runtime "header & footer code" plugin so gtag.js loads with the head
			 * instead of after an extra fetch — a late tag drops fast bounces.
			 *
			 * `is:inline` is required: without it Astro bundles the bootstrap as a
			 * deferred ES module, which runs after gtag.js and breaks dataLayer.
			 * `import.meta.env.PROD` keeps `astro dev`/preview traffic out of the
			 * stats. The measurement ID is public, so it is written literally (it
			 * appears in both tags) and the tags survive without any client JS.
			 */
			import.meta.env.PROD && (
				<>
					<script
						is:inline
						async
						src="https://www.googletagmanager.com/gtag/js?id=G-LZ7NMQ1R85"
					/>
					<script is:inline>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", "G-LZ7NMQ1R85");
					</script>
				</>
			)
		}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<Header isHome={Astro.url.pathname === "/"} menu={menu} />
		<main id="main">
			<slot />
		</main>
		<Footer siteTitle={seo.siteName} tagline={siteTagline} />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
