---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import type { Menu } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/noto-sans-tc";
import "@fontsource-variable/noto-sans-mono";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/base.css";
import original from "../assets/original.png";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, type PageMeta } from "../lib/seo";

interface Props {
	meta: PageMeta;
}

const { meta } = Astro.props;

const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const settings = settingsResult.data as { title?: string; tagline?: string };
const siteTitle = settings?.title ?? SITE_NAME;
const siteTagline = settings?.tagline ?? "碎碎唸";
const menu = menuResult.data as Menu | null;

const fullTitle = meta.title ? `${meta.title} - ${siteTitle}` : siteTitle;

const pageCtx = createPublicPageContext({
	Astro,
	kind: meta.content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: meta.pageTitle ?? meta.title,
	description: meta.description ?? siteTagline,
	canonical: meta.canonical,
	image: meta.image,
	content: meta.content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={original.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{
			/*
			 * Google Analytics 4 (G-LZ7NMQ1R85). Kept in the layout rather than a
			 * runtime "header & footer code" plugin so gtag.js loads with the head
			 * instead of after an extra fetch — a late tag drops fast bounces.
			 *
			 * `is:inline` is required: without it Astro bundles the bootstrap as a
			 * deferred ES module, which runs after gtag.js and breaks dataLayer.
			 * `import.meta.env.PROD` keeps `astro dev`/preview traffic out of the
			 * stats. The measurement ID is public, so it is written literally (it
			 * appears in both tags) and the tags survive without any client JS.
			 */
			import.meta.env.PROD && (
				<>
					<script
						is:inline
						async
						src="https://www.googletagmanager.com/gtag/js?id=G-LZ7NMQ1R85"
					/>
					<script is:inline>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", "G-LZ7NMQ1R85");
					</script>
				</>
			)
		}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<Header isHome={Astro.url.pathname === "/"} menu={menu} />
		<main id="main">
			<slot />
		</main>
		<Footer siteTitle={siteTitle} tagline={siteTagline} />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
