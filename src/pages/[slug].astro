---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../layouts/Base.astro";
import Page from "../components/Page.astro";
import { buildEntryMeta } from "../lib/seo";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const meta = await buildEntryMeta(page, { collection: "pages", slug, url: Astro.url });
---

<Base meta={meta}>
	<Page page={page} />
</Base>
