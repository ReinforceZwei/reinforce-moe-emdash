---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../layouts/Base.astro";
import Page from "../components/Page.astro";
import { resolveSeo } from "../lib/seo";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// A standalone page (about, contact) is not an article: keep og:type=website
// so no BlogPosting graph is claimed for it.
const seo = await resolveSeo({
	url: Astro.url,
	entry: page,
	collection: "pages",
	slug,
	pageType: "website",
});
---

<Base seo={seo}>
	<Page page={page} />
</Base>
