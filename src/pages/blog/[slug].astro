---
import { getEmDashEntry, getEntryTerms, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import Post from "../../components/Post.astro";
import { splitTerms } from "../../lib/content/terms";
import { guessPostSlug } from "../../lib/content/posts";
import { resolvePostImage } from "../../lib/content/media";
import { resolveSeo } from "../../lib/seo";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) {
	// A partial slug — a share or crawler that dropped the percent-encoded CJK
	// tail — 301s to the post it can only mean, the way WordPress's permalink
	// guess did. An ambiguous prefix still 404s.
	const guessed = await guessPostSlug(slug);
	if (guessed) return Astro.redirect(`/blog/${encodeURIComponent(guessed)}`, 301);
	return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Two queries, because a term does not say which taxonomy it belongs to.
const [categoryTerms, tagTerms] = await Promise.all([
	getEntryTerms("posts", post.data.id, "category"),
	getEntryTerms("posts", post.data.id, "tag"),
]);
const terms = splitTerms(categoryTerms, tagTerms);

// A post is an article: og:type, article:* tags and BlogPosting JSON-LD all
// follow from here. The featured image is the social image unless the SEO
// panel overrides it (resolveSeo applies that precedence).
const featured = resolvePostImage(post, Astro.locals.emdash?.getPublicMediaUrl);

const seo = await resolveSeo({
	url: Astro.url,
	entry: post,
	collection: "posts",
	slug,
	pageType: "article",
	image: featured?.src ?? null,
});
---

<Base seo={seo}>
	<Post post={post} terms={terms} />
</Base>
