---
import Archive from "../../layouts/Archive.astro";
import { getPostList } from "../../lib/content/posts";
import { buildPageMeta } from "../../lib/seo";
import { getPostsPerPage } from "../../lib/site";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { posts, termsByEntry, nextCursor, cacheHint } = await getPostList({
	cursor,
	limit: await getPostsPerPage(),
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const heading = "所有文章";
---

<Archive
	meta={buildPageMeta(heading)}
	heading={heading}
	posts={posts}
	termsByEntry={termsByEntry}
	prevHref={cursor ? "/blog" : null}
	nextHref={nextCursor ? `/blog?cursor=${encodeURIComponent(nextCursor)}` : null}
/>
