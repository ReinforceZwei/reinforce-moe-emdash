---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import PostPreview from "../../components/PostPreview.astro";
import { splitTerms } from "../../lib/content/terms";
import { buildPageMeta } from "../../lib/seo";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const ids = posts.map((p) => p.data.id);
const [categoriesByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", ids, "category"),
	getTermsForEntries("posts", ids, "tag"),
]);

const meta = buildPageMeta("所有文章");
---

<Base meta={meta}>
	<Container>
		<h1>所有文章</h1>
		{posts.map((post) => (
			<PostPreview
				post={post}
				terms={splitTerms(categoriesByEntry.get(post.data.id), tagsByEntry.get(post.data.id))}
			/>
		))}
		<nav class="pagination" aria-label="分頁導航">
			{cursor && <a href="/posts">第一頁</a>}
			{nextCursor && <a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>下一頁 →</a>}
		</nav>
	</Container>
</Base>
