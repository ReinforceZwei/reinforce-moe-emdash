---
import { decodeSlug, getTerm } from "emdash";
import Archive from "../../layouts/Archive.astro";
import { getPostList, parsePageNumber } from "../../lib/content/posts";
import { buildPageMeta } from "../../lib/seo";
import { getPostsPerPage } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const termResult = await getTerm("category", slug);
const term = (termResult ?? null) as { label?: string } | null;
if (!term) return Astro.rewrite("/404");

const limit = await getPostsPerPage();
const page = parsePageNumber(Astro.url.searchParams.get("page"), limit);
const heading = `分類：${term.label ?? slug}`;
const { posts, termsByEntry, hasMore, cacheHint } = await getPostList({
	where: { category: [slug] },
	page,
	limit,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageHref = (targetPage: number) =>
	targetPage === 1 ? Astro.url.pathname : `${Astro.url.pathname}?page=${targetPage}`;
---

<Archive
	meta={buildPageMeta(heading)}
	heading={heading}
	posts={posts}
	termsByEntry={termsByEntry}
	prevHref={page > 1 ? pageHref(page - 1) : null}
	nextHref={hasMore ? pageHref(page + 1) : null}
/>
