---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import Pagination from "../components/Pagination.astro";
import WidgetSlot from "../components/WidgetSlot.astro";
import CategoryList from "../components/CategoryList.astro";
import TagList from "../components/TagList.astro";
import MyProfile from "../components/MyProfile.astro";
import { getPostList } from "../lib/content/posts";
import { buildPageMeta } from "../lib/seo";
import { getPostsPerPage } from "../lib/site";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { posts, termsByEntry, nextCursor, cacheHint } = await getPostList({
	cursor,
	limit: await getPostsPerPage(),
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const meta = buildPageMeta("");
---

<Base meta={meta}>
	<div class="main-content">
		<WidgetSlot name="home-spotlight">
			<div class="spotlight-fallback">
				<img src="/hertaa1.gif" alt="くるくる" width="250" height="250" />
			</div>
		</WidgetSlot>

		<div class="column-container">
			<div class="side-column">
				<WidgetSlot name="home-left">
					<MyProfile />
				</WidgetSlot>
			</div>

			<div class="content-column">
				<PostList posts={posts} termsByEntry={termsByEntry} />
				<Pagination
					prevHref={cursor ? "/" : null}
					nextHref={nextCursor ? `/?cursor=${encodeURIComponent(nextCursor)}` : null}
				/>
			</div>

			<div class="side-column">
				<WidgetSlot name="home-right">
					<CategoryList />
					<TagList />
				</WidgetSlot>
			</div>
		</div>
	</div>
</Base>

<style>
.column-container {
	display: flex;
	flex-wrap: nowrap;
	gap: var(--space-6);
}
.side-column {
	flex-basis: 25%;
}
.content-column {
	flex-basis: 50%;
}
/* Declared after the base widths so it wins without !important. */
@media (max-width: 781px) {
	.column-container {
		flex-wrap: wrap;
	}
	.side-column,
	.content-column {
		flex-basis: 100%;
	}
}
.main-content {
	padding-left: max(var(--space-3), 4vw);
	padding-right: max(var(--space-3), 4vw);
}
.spotlight-fallback {
	text-align: center;
}
</style>
