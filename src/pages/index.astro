---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import PostPreview from "../components/PostPreview.astro";
import CategoryList from "../components/CategoryList.astro";
import TagList from "../components/TagList.astro";
import Spotlight from "../components/Spotlight.astro";
import MyProfile from "../components/MyProfile.astro";
import { splitTerms } from "../lib/content/terms";
import { buildPageMeta } from "../lib/seo";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 10,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const ids = posts.map((p) => p.data.id);
const [categoriesByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", ids, "category"),
	getTermsForEntries("posts", ids, "tag"),
]);

const meta = buildPageMeta("");
---

<Base meta={meta}>
	<div class="main-content">
		<Spotlight />

		<div class="column-container">
			<div class="side-column">
				<MyProfile />
			</div>

			<div class="content-column">
				{posts.map((post) => (
					<PostPreview
						post={post}
						terms={splitTerms(categoriesByEntry.get(post.data.id), tagsByEntry.get(post.data.id))}
					/>
				))}
				{(cursor || nextCursor) && (
					<nav class="pagination" aria-label="分頁導航">
						<div class="pagination-controls">
							{cursor && <a href="/" class="pagination-link prev">← 第一頁</a>}
							{nextCursor && (
								<a href={`/?cursor=${encodeURIComponent(nextCursor)}`} class="pagination-link next">
									下一頁 →
								</a>
							)}
						</div>
					</nav>
				)}
			</div>

			<div class="side-column">
				<CategoryList />
				<TagList />
			</div>
		</div>
	</div>
</Base>

<style>
.column-container {
	display: flex;
	flex-wrap: nowrap;
	gap: var(--space-6);
}
@media (max-width: 781px) {
	.side-column {
		flex-basis: 100% !important;
	}
	.content-column {
		flex-basis: 100% !important;
	}
	.column-container {
		flex-wrap: wrap;
	}
}
.side-column {
	flex-basis: 25%;
}
.content-column {
	flex-basis: 50%;
}
.main-content {
	padding-left: max(var(--space-3), 4vw);
	padding-right: max(var(--space-3), 4vw);
}
.pagination {
	margin-top: var(--space-6);
}
.pagination-controls {
	display: flex;
	justify-content: space-between;
}
</style>
