---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import Pagination from "../components/Pagination.astro";
import WidgetSlot from "../components/WidgetSlot.astro";
import CategoryList from "../components/CategoryList.astro";
import TagList from "../components/TagList.astro";
import MyProfile from "../components/MyProfile.astro";
import { getPostList, parsePageNumber } from "../lib/content/posts";
import { resolveSeo } from "../lib/seo";
import { getPostsPerPage } from "../lib/site";

const limit = await getPostsPerPage();
const page = parsePageNumber(Astro.url.searchParams.get("page"), limit);
const { posts, termsByEntry, hasMore, cacheHint } = await getPostList({
	page,
	limit,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageHref = (targetPage: number) =>
	targetPage === 1 ? "/" : `/?page=${targetPage}`;
// No page title: the resolver falls back to the site name, so <title> and
// og:title both carry it instead of being empty.
const seo = await resolveSeo({ url: Astro.url });
---

<Base seo={seo}>
	<div class="main-content">
		<WidgetSlot name="home-spotlight">
			<div class="spotlight-fallback">
				<img src="/hertaa1.gif" alt="くるくる" width="250" height="250" />
			</div>
		</WidgetSlot>

		<div class="column-container">
			<div class="side-column">
				<WidgetSlot name="home-left">
					<MyProfile />
				</WidgetSlot>
			</div>

			<div class="content-column">
				<PostList posts={posts} termsByEntry={termsByEntry} />
				<Pagination
					prevHref={page > 1 ? pageHref(page - 1) : null}
					nextHref={hasMore ? pageHref(page + 1) : null}
				/>
			</div>

			<div class="side-column">
				<WidgetSlot name="home-right">
					<CategoryList />
					<TagList />
				</WidgetSlot>
			</div>
		</div>
	</div>
</Base>

<style>
.column-container {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
	gap: var(--space-6);
}
@media (max-width: 781px) {
	.column-container {
		grid-template-columns: minmax(0, 1fr);
	}
}
.main-content {
	padding-left: max(var(--space-3), 4vw);
	padding-right: max(var(--space-3), 4vw);
}
.spotlight-fallback {
	text-align: center;
}
</style>
