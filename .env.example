# Public site origin (build + runtime)
EMDASH_SITE_URL=http://localhost:4321

# Optional: SQLite file. Defaults to /app/data/emdash.db (the directory the container mounts).
# When running `npm run dev` outside Docker, point it at the repo instead:
# EMDASH_DB_PATH=./data/emdash.db

# Optional: where sign-in sessions are stored. Defaults to `sessions/` beside the database
# (/app/data/sessions in the container). Keep it on the mounted volume — if it falls inside the
# container layer, every recreate (`docker compose up -d`, image update) logs the admin out.
# EMDASH_SESSION_PATH=/app/data/sessions

# Generate with: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=
EMDASH_PREVIEW_SECRET=

# S3-compatible media storage (Cloudflare R2, MinIO, AWS S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Optional: Cloudflare Turnstile spam protection for the built-in comments.
# The site key only decides whether the widget renders; both values are read from the
# environment at request time, so setting them needs a restart, not an image rebuild.
# Without the secret the token is ignored, so set both or neither — a secret with no
# widget makes every submission fail (verification fails closed).
PUBLIC_TURNSTILE_SITE_KEY=
EMDASH_TURNSTILE_SECRET_KEY=
